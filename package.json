{
  "name": "archpilot-mcp",
  "version": "0.1.1",
  "description": "Plan before you code: an MCP server + Claude Code skill that interviews you, runs a pre-mortem, and writes a validated architecture diagram and ARCHITECTURE.md contract.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "claude",
    "skill",
    "architecture",
    "system-design",
    "mermaid",
    "diagram",
    "planning"
  ],
  "homepage": "https://github.com/saimsheikh/archpilot#readme",
  "bugs": {
    "url": "https://github.com/saimsheikh/archpilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimsheikh/archpilot.git"
  },
  "author": "saim sheikh",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "archpilot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "patterns"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "eval:retrieval": "tsx evals/retrieval/run.ts",
    "eval": "tsx evals/harness/run.ts",
    "prepack": "npm run build",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
